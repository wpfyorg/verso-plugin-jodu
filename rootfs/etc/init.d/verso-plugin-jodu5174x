#!/bin/sh /etc/rc.common
START=97
STOP=10
USE_PROCD=1
start_service() {
  [ -x /usr/bin/verso-plugin-jodu5174x ] || return 1
  account=verso-plugin-jodu5174x
  runtime=/var/run/verso-plugin-jodu5174x
  id verso >/dev/null 2>&1 || return 1
  if ! id "$account" >/dev/null 2>&1; then
    uid="$(awk -F: '{used[$3]=1} END {for (n=6100;n<65000;n++) if (!used[n]) {print n; exit}}' /etc/passwd)"
    [ -n "$uid" ] || return 1
    gid="$(id -g verso)" || return 1
    printf '%s:x:%s:%s:Verso ODU plugin:%s:/bin/false\n' "$account" "$uid" "$gid" "$runtime/ui" >> /etc/passwd || return 1
  fi
  [ "$(id -u "$account")" != 0 ] || return 1
  mkdir -p "$runtime" "$runtime/ui" "$runtime/uci" || return 1
  chown root:verso "$runtime" && chmod 0750 "$runtime" || return 1
  chown "$account":verso "$runtime/ui" && chmod 0750 "$runtime/ui" || return 1
  chown root:root "$runtime/uci" && chmod 0700 "$runtime/uci" || return 1
  procd_open_instance config
  procd_set_param command /usr/bin/verso-plugin-jodu5174x --export-config "$runtime/config.json"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
  procd_open_instance ui
  procd_set_param command /usr/bin/verso-plugin-jodu5174x --config-snapshot "$runtime/config.json"
  procd_set_param user "$account"
  procd_set_param group verso
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
